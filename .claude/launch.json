{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lp-clube-suprema",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3000
    },
    {
      "name": "lp-jornada-teste",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3100,
      "env": { "PORT": "3100", "FLOW": "completo", "SUPREMA_MODE": "app", "F24H_MODE": "mock", "DATA_DIR": "data/teste-jornada" }
    },
    {
      "name": "lp-jornada-real",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3200,
      "env": { "PORT": "3200", "FLOW": "completo", "SUPREMA_MODE": "app", "F24H_MODE": "real", "F24H_DEBUG": "1", "DATA_DIR": "data/teste-real" }
    },
    {
      "name": "lp-jornada-guiada",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3300,
      "env": { "PORT": "3300", "FLOW": "completo", "SUPREMA_MODE": "app", "F24H_MODE": "guiado", "DATA_DIR": "data/teste-guiada" }
    }
  ]
}

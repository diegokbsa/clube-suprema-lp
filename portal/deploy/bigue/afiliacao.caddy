# kbsa.app/<blog> -> Portal de Afiliação (edição Geral, 127.0.0.1:3400), operação "Afiliação" (PA-160).
# Vai para E:\LioraServidor\kbsa-deploy\caddy\rotas\afiliacao.caddy (importado pelo bloco :8082 do kbsa.app).
# O portal serve o site em /s/af-<blog>/ e, com X-Portal-Prefix, gera links/canonical/sitemap em https://kbsa.app/<blog>.
@af_blogs {
	host kbsa.app
	path_regexp afb ^/(achadinhos|sublimacao|manutencao|fornecedores|ia|criativos|gamer|afiliado|milhas|automacao)(/.*)?$
}
handle @af_blogs {
	rewrite * /s/af-{re.afb.1}{re.afb.2}
	reverse_proxy 127.0.0.1:3400 {
		header_up X-Portal-Prefix /{re.afb.1}
		header_up X-Forwarded-Proto https
	}
}
# Arquivos e formulários públicos do portal usados por essas páginas (o kbsa.app estático não tem /assets, /f nem /r).
@af_portal {
	host kbsa.app
	path /assets/* /f/* /r/*
}
handle @af_portal {
	reverse_proxy 127.0.0.1:3400 {
		header_up X-Forwarded-Proto https
	}
}
